<Window x:Class="GoodbyeDPI.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodbyeDPI.UI"
        mc:Ignorable="d"
        Title="GoodbyeDPI Control &amp; Steam Connectivity Tool" Height="680" Width="920"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="GoodbyeDPI &amp; Steam Connectivity Manager" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock Text="Manage network adapter DNS, configure GoodbyeDPI transparent proxy, and verify Steam connectivity." FontSize="12" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="#313244" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="StatusBadgeText" Text="GoodbyeDPI: Stopped" Foreground="#F38BA8" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="AdvancedToggleBtn" Content="Advanced mode" Margin="10,0,0,0" Click="AdvancedToggleBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Simple (one-click) view -->
        <Border x:Name="SimplePanel" Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Button x:Name="OneClickBtn" Content="Connect" Width="280" Height="68" FontSize="22" FontWeight="Bold" Background="#A6E3A1" Foreground="#11111B" Click="OneClickBtn_Click"/>
                    <TextBlock x:Name="OneClickStatus" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="#A6ADC8" Text="Click Connect to start GoodbyeDPI and verify Steam."/>
                    <ProgressBar x:Name="OneClickProgress" Height="5" Width="280" Margin="0,10,0,0" IsIndeterminate="True" Foreground="#89B4FA" Visibility="Hidden"/>
                    <Button x:Name="ServiceBtnSimple" Content="Install as service" Margin="0,18,0,0" HorizontalAlignment="Center" Click="ServiceBtn_Click"/>
                    <TextBlock x:Name="ServiceStatusSimple" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#6C7086" Text="Service: checking..."/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SimpleResultsList" HorizontalAlignment="Center" MinWidth="600">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Text" Value="PASS"/>
                                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Text" Value="FAIL"/>
                                                        <Setter Property="Foreground" Value="#F38BA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetName}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#A6ADC8" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Advanced tabs -->
        <TabControl x:Name="AdvancedTabs" Grid.Row="1" Visibility="Collapsed" Background="#181825" BorderBrush="#313244">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="Background" Value="#1E1E2E"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="BorderBrush" Value="#313244"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DNS Management -->
            <TabItem Header="DNS Management">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Network Adapter Selection">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AdapterComboBox" Grid.Column="0" SelectionChanged="AdapterComboBox_SelectionChanged" Height="30"/>
                                <Button x:Name="RefreshAdaptersBtn" Grid.Column="1" Content="Refresh Adapters" Margin="8,0,0,0" Click="RefreshAdaptersBtn_Click"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="DNS Presets">
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Cloudflare (1.1.1.1 / 1.0.0.1)" Margin="0,0,8,6" Click="PresetCloudflare_Click"/>
                                <Button Content="Google (8.8.8.8 / 8.8.4.4)" Margin="0,0,8,6" Click="PresetGoogle_Click"/>
                                <Button Content="Quad9 (9.9.9.9 / 149.112.112.112)" Margin="0,0,8,6" Click="PresetQuad9_Click"/>
                                <Button Content="AdGuard (94.140.14.14 / 94.140.15.15)" Margin="0,0,8,6" Click="PresetAdGuard_Click"/>
                                <Button Content="OpenDNS (208.67.222.222 / 208.67.220.220)" Margin="0,0,8,6" Click="PresetOpenDns_Click"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="Adapter IPv4 DNS Configuration">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Primary DNS:" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="PrimaryDnsInput" Grid.Row="0" Grid.Column="1" Margin="0,4" Text="1.1.1.1"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Secondary DNS:" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="SecondaryDnsInput" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="1.0.0.1"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Current DNS in use:" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock x:Name="CurrentDnsDisplay" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,4" Foreground="#A6ADC8" Text="(Select an adapter)"/>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="ApplyDnsBtn" Content="Apply DNS to Adapter" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Margin="0,0,10,0" Click="ApplyDnsBtn_Click"/>
                                    <Button x:Name="ResetDnsBtn" Content="Reset to Automatic (DHCP)" Margin="0,0,10,0" Click="ResetDnsBtn_Click"/>
                                    <Button x:Name="FlushDnsBtn" Content="Flush DNS Cache" Click="FlushDnsBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="GoodbyeDPI UDP DNS Redirection">
                            <StackPanel>
                                <CheckBox x:Name="EnableDpiDnsRedir" Content="Redirect UDP DNS traffic inside GoodbyeDPI (--dns-addr &amp; --dnsv6-addr)" Foreground="#CDD6F4" IsChecked="True" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Redirect IPv4 DNS:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DpiDnsAddrInput" Grid.Row="0" Grid.Column="1" Margin="0,4,10,4" Text="1.1.1.1"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DpiDnsPortInput" Grid.Row="0" Grid.Column="3" Margin="0,4" Text="53"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Redirect IPv6 DNS:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DpiDnsV6AddrInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Text="2606:4700:4700::1111"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode Preset:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="DpiModeCombo" Grid.Row="2" Grid.Column="1" Margin="0,6,10,0" SelectedIndex="0">
                                        <ComboBoxItem Content="-1: Most compatible mode"/>
                                        <ComboBoxItem Content="-2: Better speed and compatibility"/>
                                        <ComboBoxItem Content="-3: Better speed, HTTP and HTTPS"/>
                                        <ComboBoxItem Content="-4: Best speed"/>
                                        <ComboBoxItem Content="-5: Extreme mode"/>
                                        <ComboBoxItem Content="-9: Alternative mode (Russia/ISPs)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Steam Connectivity Test -->
            <TabItem Header="Steam Connectivity Test">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11111B" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Steam Network Diagnostic Suite" FontWeight="Bold" FontSize="14" Foreground="#89B4FA"/>
                                <TextBlock Text="Tests DNS resolution, Steam Store &amp; Community HTTPS connections, and Steam CM / CDN TCP sockets." Foreground="#A6ADC8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="RunSteamTestBtn" Grid.Column="1" Content="▶ Run Steam Connectivity Test" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Height="36" Padding="14,0" Click="RunSteamTestBtn_Click"/>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="TestProgressBar" Grid.Row="1" Height="6" Margin="0,0,0,10" Visibility="Collapsed" IsIndeterminate="True" Foreground="#89B4FA"/>

                    <DataGrid x:Name="SteamResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#11111B" Foreground="#CDD6F4" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#313244" HeadersVisibility="Column"
                              RowBackground="#181825" AlternatingRowBackground="#1E1E2E" BorderBrush="#313244">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Target / Service" Binding="{Binding TargetName}" Width="220"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Background" Value="#2E4F32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="#5C2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                                <Setter Property="Text" Value="PASS"/>
                                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Text" Value="FAIL"/>
                                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="100"/>
                            <DataGridTextColumn Header="Details / Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: GoodbyeDPI Control & Logs -->
            <TabItem Header="GoodbyeDPI Daemon &amp; Logs">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Executable Path:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExePathInput" Grid.Column="1" Margin="0,0,8,0"/>
                        <Button x:Name="BrowseExeBtn" Grid.Column="2" Content="Browse..." Click="BrowseExeBtn_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
                        <Button x:Name="StartDpiBtn" Content="▶ Start GoodbyeDPI" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Margin="0,0,10,0" Click="StartDpiBtn_Click"/>
                        <Button x:Name="StopDpiBtn" Content="⏹ Stop GoodbyeDPI" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Margin="0,0,10,0" IsEnabled="False" Click="StopDpiBtn_Click"/>
                        <Button x:Name="ClearLogsBtn" Content="Clear Output Log" Click="ClearLogsBtn_Click"/>
                        <Button x:Name="ServiceBtnAdv" Content="Install as service" Margin="10,0,0,0" Click="ServiceBtn_Click"/>
                    </StackPanel>

                    <TextBox x:Name="LogsTextBox" Grid.Row="2" Background="#11111B" Foreground="#BAC2DE" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#11111B" Foreground="#A6ADC8" Margin="0,8,0,0" Padding="6,4">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
